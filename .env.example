# Application
APP_NAME="Music Transcription API"
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./transcription.db

# File Storage
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
MAX_FILE_SIZE=52428800

# Redis (optional)
REDIS_URL=redis://localhost:6379/0

# API Keys (if needed)
# OPENAI_API_KEY=your_key_here

# Neural transcription model (optional).
# Set to a .pt checkpoint path to use the polyphonic onset+frame model.
# Leave unset to fall back to the simple librosa monophonic pipeline.
# NEURAL_MODEL_CHECKPOINT=./app/models/Audio_project/artifacts/run_v3/best_model.pt