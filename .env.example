# Application
APP_NAME="Music Transcription API"
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./transcription.db

# File Storage
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
MAX_FILE_SIZE=52428800

# Redis (optional)
REDIS_URL=redis://localhost:6379/0

# API Keys (if needed)
# OPENAI_API_KEY=your_key_here